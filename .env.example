PORT=4000
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=
CORS_ORIGINS=http://localhost:4200
EMERGENCY_COOLDOWN_SECONDS=60

# Twilio (obsoleto, reemplazado por Infobip)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE=

# Infobip Voice API (activación de sirena)
INFOBIP_BASE_URL=https://<tu-subdominio>.api.infobip.com
INFOBIP_API_KEY=
# Número origen registrado en tu cuenta Infobip (formato E.164, ej: +593XXXXXXXXX)
INFOBIP_FROM_NUMBER=

FIREBASE_STORAGE_BUCKET=
# Use solo una de estas alternativas para la cuenta de servicio:
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_JSON=
# La ruta debe apuntar a un archivo fuera del repositorio.
FIREBASE_SERVICE_ACCOUNT_PATH=